// SpotiStats runtime configuration TEMPLATE.
//
// Copy this file to `Secrets.xcconfig` (same folder) and fill in real values.
// `Secrets.xcconfig` is git-ignored and must NEVER be committed.
//
// NOTE: the Spotify *client secret* is NOT here and never ships in the app.
// It lives only in Supabase (Auth provider config + Edge Function secrets).
//
// We store the Supabase project REF (not the full URL) on purpose: xcconfig treats `//`
// as the start of a comment, so a value like `https://xyz.supabase.co` would be truncated.
// The app builds the full URL in code as: https://<ref>.supabase.co

// Your Supabase project ref (the subdomain, e.g. "abcdefghijklmnop").
SUPABASE_PROJECT_REF = your-project-ref

// Your Supabase anon/publishable key (a JWT; safe to embed in a client app).
SUPABASE_ANON_KEY = your-anon-key

// Custom URL scheme used for the OAuth redirect (no slashes). e.g. "spotistats".
// The full redirect becomes: spotistats://login-callback
OAUTH_CALLBACK_SCHEME = spotistats
